{
    # Global options
    email {$ACME_EMAIL:admin@example.com}
    admin off
}

# Domain configured via DOMAIN environment variable (e.g. DOMAIN=yourdomain.com or localhost)
# Caddy automatically provisions and renews SSL certificates via Let's Encrypt / ZeroSSL for HTTPS on port 443
{$DOMAIN:localhost} {
    encode gzip zstd

    # Security & HTTPS Headers (HSTS, No-Sniff, X-Frame)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API & GraphQL reverse proxy to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /graphql* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # Frontend reverse proxy to Next.js
    handle {
        reverse_proxy frontend:3000
    }
}
